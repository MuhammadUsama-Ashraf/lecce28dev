# ─── Database (Neon Postgres) ────────────────────────────────────────────────
# Two connections per environment: the pooled one the app uses at runtime, and
# the direct one Prisma Migrate needs (pgbouncer cannot hold migration locks).
# Development and production must point at DIFFERENT Neon projects/branches.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/lecce28?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/lecce28?sslmode=require"

# ─── Sessions ────────────────────────────────────────────────────────────────
# 32+ random bytes. Generate with: openssl rand -base64 32
SESSION_SECRET=""

# ─── Stripe ──────────────────────────────────────────────────────────────────
# Use test keys in development and live keys in production.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ─── Vercel Blob (product image uploads) ─────────────────────────────────────
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# ─── Site ────────────────────────────────────────────────────────────────────
# Absolute origin, used for Stripe redirect URLs and emails.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
